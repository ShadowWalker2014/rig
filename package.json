    "prepublishOnly": "bun test && tsc --noEmit",
    "docs": "bun scripts/gen-docs.ts",
    "e2e": "bun test/e2e.ts"
  },
  "dependencies": {
    "e2b": "2.51.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
