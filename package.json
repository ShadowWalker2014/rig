{
  "name": "@shadowwalker2014/rig",
  "version": "0.1.0",
  "description": "Open-source cloud desktops for AI agents. Each agent gets a Linux desktop with a dev server, tests and a signed-in Chrome that pauses when idle, so your laptop stays fast.",
  "keywords": [
    "computer-use",
    "ai-agents",
    "cloud-desktop",
    "claude-code",
    "ai-coding-agent",
    "cloud-dev-environment",
    "remote-development",
    "e2b",
    "sandbox",
    "remote-browser",
    "headful-chrome",
    "agent-browser",
    "dev-server",
    "localhost",
    "vnc",
    "cli",
    "bun"
  ],
  "homepage": "https://github.com/ShadowWalker2014/rig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShadowWalker2014/rig.git"
  },
  "bugs": {
    "url": "https://github.com/ShadowWalker2014/rig/issues"
  },
  "license": "MIT",
  "author": "ShadowWalker2014",
  "type": "module",
  "bin": {
    "rig": "bin/rig"
  },
  "files": [
    "bin",
    "config",
    "image",
    "skills",
    "src",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
