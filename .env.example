# rig settings. Copy this file to ~/.config/rig/.env and fill in your key:
#
#   mkdir -p ~/.config/rig && cp .env.example ~/.config/rig/.env && chmod 600 ~/.config/rig/.env
#
# rig reads settings from, in order: your shell environment, ~/.config/rig/.env,
# then the macOS Keychain (`rig login`). It never reads .env files in the repo you
# run it from.

# Required. Create one at https://e2b.dev/dashboard?tab=keys
RIG_E2B_API_KEY=

# Optional. Only for self-hosted E2B; leave empty for E2B Cloud.
RIG_E2B_DOMAIN=

# Optional. Minutes without a rig command before a box pauses (default 15).
RIG_IDLE_MIN=15

# Optional. Box size, fixed when `rig image build` runs. E2B's free plan allows 2 / 4096.
RIG_BOX_CPU=4
RIG_BOX_MEMORY_MB=8192

# Optional. Names of the golden snapshot and base image in your E2B team.
RIG_GOLDEN=rig-golden
RIG_BASE_TEMPLATE=rig-base
